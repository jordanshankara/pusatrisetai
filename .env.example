# Setup lokal: MySQL/MariaDB via XAMPP (menyimpang dari BUILD_SPEC Bagian 3 yang menetapkan
# PostgreSQL 16 + docker-compose — lihat catatan adaptasi di kepala prisma/schema.prisma).
# Kalau XAMPP MySQL Anda punya password: mysql://root:PASSWORD@localhost:3306/pusatriset
DATABASE_URL=mysql://root@localhost:3306/pusatriset
ADMIN_EMAIL=admin@pusatriset.ai
ADMIN_PASSWORD=changeme-local-only
ENABLE_OPENALEX_FETCH=false
OPENALEX_MAILTO=dev@pusatriset.ai
