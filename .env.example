# Setup lokal: MySQL/MariaDB via XAMPP (menyimpang dari BUILD_SPEC Bagian 3 yang menetapkan
# PostgreSQL 16 + docker-compose — lihat catatan adaptasi di kepala prisma/schema.prisma).
# Kalau XAMPP MySQL Anda punya password: mysql://root:PASSWORD@localhost:3306/pusatriset
DATABASE_URL=mysql://root@localhost:3306/pusatriset
ADMIN_EMAIL=admin@pusatriset.ai
ADMIN_PASSWORD=changeme-local-only
# Dipakai HANYA untuk bootstrap akun admin pertama (scripts/bootstrap-admin-user.ts) — login
# sungguhan lewat tabel User (multi-user: admin/editor, lihat src/app/api/admin/login/route.ts).
SESSION_SECRET=change-this-to-a-long-random-string-in-production
ENABLE_OPENALEX_FETCH=false
OPENALEX_MAILTO=dev@pusatriset.ai

# Bagian B (BRIEF Round 2) — backfill ringkasan & keterkaitan, 2 tingkat provider (lihat
# scripts/lib/llm-client.ts). Gemini dicoba dulu (gratis, quota kecil per hari), fallback
# ke model gratis OpenRouter kalau Gemini habis. Salah satu boleh dikosongkan asal yang lain terisi.
GEMINI_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-3-flash-preview
OPENROUTER_API_KEY=your-openrouter-api-key
